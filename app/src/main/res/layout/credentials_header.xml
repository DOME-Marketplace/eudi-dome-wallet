<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.credentials.CredentialsActivity">

    <data>
        <import type="android.view.View"/>
        <variable
            name="viewModel"
            type="com.inetum.eudi_dome_wallet.ui.dataExchange.DataExchangeViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/layoutBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:onClick="onClickClose"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="TouchTargetSizeCheck">

            <ImageView
                android:id="@+id/imageBack"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                app:srcCompat="@drawable/icon_arrow_back_svg" />

            <TextView
                android:id="@+id/textBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:fontFamily="@font/blinker_bold"
                android:text="@string/credential_detail_back"
                android:textAllCaps="true"
                android:textSize="11sp" />

        </LinearLayout>


        <ImageView
            android:id="@+id/imageView24"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_credentialsAction_description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.496"
            app:layout_constraintStart_toStartOf="@+id/layoutBack"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/logo_svg" />

        <TextView
            android:id="@+id/tv_credentialsAction_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="26dp"
            android:layout_marginTop="50dp"
            android:layout_marginEnd="26dp"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="@string/receive_cred_desc" />





        <TextView
            android:id="@+id/tv_credentialsAction_purpose"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@+id/tv_credentialsAction_description"
            app:layout_constraintStart_toStartOf="@+id/tv_credentialsAction_description"
            app:layout_constraintTop_toBottomOf="@+id/tv_credentialsAction_description"
            tools:text="> Proposito de la Presentation Request" />


        <TextView
            android:id="@+id/tv_credentialsAction_purpose_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/presentation_request_sub"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="@+id/tv_credentialsAction_purpose"
            app:layout_constraintStart_toStartOf="@+id/tv_credentialsAction_purpose"
            app:layout_constraintTop_toBottomOf="@+id/tv_credentialsAction_purpose"/>


        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="26dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="26dp"
            android:background="@drawable/rounded_rectangle_alert"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_credentialsAction_purpose_info">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_margin="14dp"
                app:srcCompat="@drawable/icon_warning"
                tools:srcCompat="@drawable/icon_warning" />

            <TextView
                android:id="@+id/textView28"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:fontFamily="@font/blinker_bold"
                android:gravity="center_vertical"
                android:textColor="#6b1200"
                android:textSize="12sp"
                tools:text="Faltan X dato/s solicitados por la entidad" />
        </LinearLayout>



        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:onClick="onClickTerms"
            app:layout_constraintEnd_toEndOf="@+id/linearLayout"
            app:layout_constraintStart_toStartOf="@+id/linearLayout"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout">

            <TextView
                android:id="@+id/tv_credentialsAction_terms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/receive_cred_terms"
                android:textAlignment="center"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imageView34"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_margin="6dp"
                app:srcCompat="@drawable/ic_external_arrow" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
