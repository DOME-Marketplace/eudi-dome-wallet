<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Eudiwallet" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_color_black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/primary_color_white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/primary_color_white</item>
        <!-- This tells the system the background is white, so it sets the status bar as a dark color so they contrast -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:textViewStyle">@style/EudiTextViewStyleP1</item>
        <item name="materialButtonStyle">@style/EudiButtonStyleEnabled</item>
        <item name="android:buttonStyleToggle">@style/EudiToggleButtonStyle</item>
    </style>

    <style name="Theme.Eudiwallet.Fullscreen" parent="Theme.Eudiwallet">
    </style>
    <style name="Theme.Eudiwallet.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="Theme.Eudiwallet.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.Eudiwallet.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

</resources>