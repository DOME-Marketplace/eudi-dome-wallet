<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashActivity">

    <activity
        android:id="@+id/splashActivity"
        android:name="com.inetum.eudi_dome_wallet.ui.splash.SplashActivity"
        android:label="activity_splash"
        tools:layout="@layout/activity_splash">
        <deepLink
            android:id="@+id/deepLink_eudi_credentials"
            app:uri="openid-credential-offer://?credential_offer_uri={arg1}" />

        <action
            android:id="@+id/action_splashActivity_to_qrCaptureActivity"
            app:destination="@id/qrCaptureActivity" />
    </activity>
    <activity
        android:id="@+id/loginActivity"
        android:name="com.inetum.eudi_dome_wallet.ui.login.LoginActivity"
        android:label="activity_login"
        tools:layout="@layout/activity_login" />
    <activity
        android:id="@+id/registryActivity"
        android:name="com.inetum.eudi_dome_wallet.ui.register.RegisterStep1Activity"
        android:label="activity_registry"
        tools:layout="@layout/activity_register_step_1" />
    <activity
        android:id="@+id/qrCaptureActivity"
        android:name="com.inetum.eudi_dome_wallet.ui.qrcapture.QrCaptureActivity"
        android:label="activity_qr_capture"
        tools:layout="@layout/activity_qr_capture" />
</navigation>