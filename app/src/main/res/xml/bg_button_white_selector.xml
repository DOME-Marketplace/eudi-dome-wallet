<?xml version="1.0" encoding="UTF-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#ffffff" />
            <corners android:radius="50dp"/>
            <stroke
                android:width="2dp"
                android:color="@color/color_button_press" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape>
            <solid android:color="#ffffff" />
            <corners android:radius="50dp"/>
            <stroke
                android:width="2dp"
                android:color="@color/secondary_color_darkblue" />
        </shape>
    </item>

    <item android:state_enabled="false">
        <shape>
            <corners android:radius="50dp"/>
            <solid android:color="@color/complementary_color_4"/>
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="@color/primary_color_white" />
            <corners android:radius="50dp"/>
            <stroke
                android:width="2dp"
                android:color="@color/primary_color_black" />
        </shape>
    </item>
</selector>
