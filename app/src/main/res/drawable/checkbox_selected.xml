<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo del checkbox -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000"/> <!-- Color de fondo cuando está seleccionado -->
            <stroke
                android:width="2dp"
            android:color="#000"/> <!-- Color del borde -->
        </shape>
    </item>
    <!-- Ícono de verificación -->
    <item android:drawable="@drawable/ic_check_white"
        android:height="2dp"
        android:width="2dp"
        android:gravity="center"/>
</layer-list>